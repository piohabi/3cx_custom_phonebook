[Unit]
Description=3CX → Yealink AX Phonebook Sync Service
After=network.target
Documentation=https://example.com/docs/3cx-yealink-sync
Wants=network-online.target

[Service]
Type=simple

# Benutzer (muss vorher erstellt werden)
User=3cx_sync
Group=3cx_sync

# Arbeitsverzeichnis
WorkingDirectory=/opt/3cx_yealink_sync

# Hauptbefehl - PASSE DIE PFADE AN!
ExecStart=/usr/bin/python3 /opt/3cx_yealink_sync/3cx_yealink_sync.py \
  --input /var/lib/3cx/phonebook/contacts_3cx.csv \
  --output /var/www/html/phonebook \
  --interval 300 \
  --port 8080 \
  --log-file /var/log/3cx_yealink_sync.log

# Restart-Verhalten
Restart=always
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

# Prozess-Handling
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=30

# Umgebungsvariablen (optional)
Environment="PYTHONUNBUFFERED=1"

# Limits (optional)
LimitNOFILE=4096
LimitNPROC=4096

# Sicherheit (optional)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/html/phonebook /var/log/3cx_yealink_sync.log

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=3cx-yealink-sync
StandardOutputMaxSize=10M

[Install]
WantedBy=multi-user.target
